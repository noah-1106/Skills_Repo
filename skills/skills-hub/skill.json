{
  "name": "skills-hub",
  "version": "1.2.0",
  "description": "Live search, install, and update skills from the ClawHub marketplace (zero dependencies, no cache)",
  "author": "hongyunai",
  "bin": "scripts/skills_hub.py",
  "dependencies": [],
  "commands": {
    "search": {
      "description": "Live keyword search on ClawHub",
      "args": [
        "query..."
      ]
    },
    "show": {
      "description": "Show skill details",
      "args": [
        "--slug"
      ]
    },
    "install": {
      "description": "Download and install a skill",
      "args": [
        "--slug"
      ]
    },
    "update": {
      "description": "Check latest versions of installed skills"
    },
    "list": {
      "description": "List ClawHub-sourced installed skills"
    }
  }
}