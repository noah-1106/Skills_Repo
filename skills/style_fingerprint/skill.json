{
  "name": "style-fingerprint",
  "version": "2.0.0",
  "description": "Analyze/compare/merge Chinese writing style fingerprints (zero dependencies)",
  "author": "hongyunai",
  "bin": "style_fingerprint.py",
  "dependencies": [],
  "commands": {
    "analyze": {
      "description": "Analyze text and save fingerprint",
      "args": [
        "--text",
        "--file",
        "--name"
      ]
    },
    "list": {
      "description": "List all saved fingerprints"
    },
    "show": {
      "description": "Show fingerprint details",
      "args": [
        "--name"
      ]
    },
    "delete": {
      "description": "Delete a fingerprint",
      "args": [
        "--name"
      ]
    },
    "export": {
      "description": "Export style guide with exemplar sentences",
      "args": [
        "--name",
        "--output"
      ]
    },
    "compare": {
      "description": "Check draft style against fingerprint",
      "args": [
        "--name",
        "--text",
        "--file"
      ]
    },
    "merge": {
      "description": "Merge fingerprints weighted by char count",
      "args": [
        "--names",
        "--name"
      ]
    },
    "selftest": {
      "description": "Run built-in regression tests"
    }
  }
}